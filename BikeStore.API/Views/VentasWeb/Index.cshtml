@model List<BikeStore.API.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
}

<div style="max-width:1100px; margin:40px auto; font-family:Arial;">

    <h1>🧾 Ventas</h1>

    @if (TempData["Error"] != null)
    {
        <div style="background:#f8d7da;
            color:#842029;
            padding:12px;
            margin-bottom:15px;
            border-radius:5px;">
            @TempData["Error"]
        </div>
    }

    <a href="/VentasWeb/Crear"
       style="display:inline-block;
        background:#198754;
        color:white;
        padding:10px 18px;
        text-decoration:none;
        border-radius:5px;
        margin:15px 0;">
        ➕ Nueva venta
    </a>

    <p>Listado de ventas registradas en BikeStore.</p>

    <table style="width:100%;
        border-collapse:collapse;
        margin-top:30px;">

        <thead>

            <tr style="background-color:#198754;
                color:white;">

                <th style="padding:12px;">ID</th>
                <th style="padding:12px;">Fecha</th>
                <th style="padding:12px;">Cliente</th>
                <th style="padding:12px;">Subtotal</th>
                <th style="padding:12px;">IVA</th>
                <th style="padding:12px;">Total</th>
                <th style="padding:12px;">Acciones</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var venta in Model)
            {
                <tr style="border-bottom:1px solid #ddd;">

                    <td style="padding:10px;
                        text-align:center;">
                        @venta.IdVenta
                    </td>

                    <td style="padding:10px;
                        text-align:center;">

                        @(venta.Fecha?.ToString("dd/MM/yyyy") ?? "-")

                    </td>

                    <td style="padding:10px;
                        text-align:center;">
                        @venta.IdCliente
                    </td>

                    <td style="padding:10px;">
                        $@venta.Subtotal.ToString("0.00")
                    </td>

                    <td style="padding:10px;">
                        $@venta.IVA.ToString("0.00")
                    </td>

                    <td style="padding:10px;
                        font-weight:bold;">
                        $@venta.Total.ToString("0.00")
                    </td>

                    <td style="padding:10px;
                        text-align:center;">

                        <a href="/VentasWeb/Editar/@venta.IdVenta"
                           style="background:#ffc107;
                            color:black;
                            padding:6px 12px;
                            text-decoration:none;
                            border-radius:5px;">
                            ✏️ Editar
                        </a>

                        <form method="post"
                              action="/VentasWeb/Eliminar/@venta.IdVenta"
                              style="display:inline;"
                              onsubmit="return confirm('¿Está seguro de eliminar esta venta?');">

                            <button type="submit"
                                    style="background:#dc3545;
                                color:white;
                                border:none;
                                padding:6px 12px;
                                border-radius:5px;
                                margin-left:5px;
                                cursor:pointer;">
                                🗑️ Eliminar
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

    <br />

    <a href="/Home/Index">
        ⬅ Volver al inicio
    </a>

</div>
