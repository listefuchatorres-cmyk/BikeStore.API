@model List<BikeStore.API.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div style="max-width:1100px; margin:40px auto; font-family:Arial;">

    <h1>👥 Clientes</h1>

    @if (TempData["Error"] != null)
    {
        <div style="background:#f8d7da;
            color:#842029;
            padding:12px;
            margin-bottom:15px;
            border-radius:5px;">
            @TempData["Error"]
        </div>
    }

    <a href="/ClientesWeb/Crear"
       style="display:inline-block;
        background:#198754;
        color:white;
        padding:10px 18px;
        text-decoration:none;
        border-radius:5px;
        margin:15px 0;">
        ➕ Nuevo cliente
    </a>

    <div style="margin:20px 0;
        padding:15px;
        background:#f8f9fa;
        border-radius:8px;">

        <h3>🔎 Buscar clientes</h3>

        <form method="get"
              action="/ClientesWeb/Buscar"
              style="display:flex;
            gap:10px;
            align-items:center;
            flex-wrap:wrap;">

            <select name="tipo"
                    style="padding:10px;
                border:1px solid #ccc;
                border-radius:5px;">

                <option value="cedula">Cédula</option>
                <option value="apellido">Apellido</option>

            </select>

            <input type="text"
                   name="valor"
                   placeholder="Ingrese el dato a buscar"
                   required
                   style="padding:10px;
            width:300px;
            border:1px solid #ccc;
            border-radius:5px;" />

            <button type="submit"
                    style="background:#0d6efd;
                color:white;
                border:none;
                padding:10px 18px;
                border-radius:5px;
                cursor:pointer;">
                🔎 Buscar
            </button>

            <a href="/ClientesWeb"
               style="background:#6c757d;
                color:white;
                padding:10px 18px;
                text-decoration:none;
                border-radius:5px;">
                Mostrar todos
            </a>

        </form>

    </div>

    <p>Listado de clientes registrados en BikeStore.</p>

    <table style="width:100%;
        border-collapse:collapse;
        margin-top:30px;">

        <thead>

            <tr style="background-color:#198754; color:white;">

                <th style="padding:12px;">ID</th>
                <th style="padding:12px;">Cédula</th>
                <th style="padding:12px;">Nombres</th>
                <th style="padding:12px;">Apellidos</th>
                <th style="padding:12px;">Teléfono</th>
                <th style="padding:12px;">Correo</th>
                <th style="padding:12px;">Acciones</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var cliente in Model)
            {
                <tr>

                    <td style="padding:10px; text-align:center;">
                        @cliente.IdCliente
                    </td>

                    <td style="padding:10px;">
                        @cliente.Cedula
                    </td>

                    <td style="padding:10px;">
                        @cliente.Nombres
                    </td>

                    <td style="padding:10px;">
                        @cliente.Apellidos
                    </td>

                    <td style="padding:10px;">
                        @cliente.Telefono
                    </td>

                    <td style="padding:10px;">
                        @cliente.Correo
                    </td>

                    <td style="padding:10px; text-align:center;">

                        <a href="/ClientesWeb/Editar/@cliente.IdCliente"
                           style="background:#ffc107;
                            color:black;
                            padding:6px 12px;
                            text-decoration:none;
                            border-radius:5px;">
                            ✏️ Editar
                        </a>

                        <form method="post"
                              action="/ClientesWeb/Eliminar/@cliente.IdCliente"
                              style="display:inline;"
                              onsubmit="return confirm('¿Está seguro de eliminar este cliente?');">

                            <button type="submit"
                                    style="background:#dc3545;
                                color:white;
                                border:none;
                                padding:6px 12px;
                                border-radius:5px;
                                margin-left:5px;
                                cursor:pointer;">
                                🗑️ Eliminar
                            </button>

                        </form>


                    </td>

                </tr>
            }

        </tbody>

    </table>

    <br />

    <a href="/Home/Index">⬅ Volver al inicio</a>

</div>
