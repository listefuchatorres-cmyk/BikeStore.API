@model List<BikeStore.API.Models.DetalleVenta>

@{
    ViewData["Title"] = "Detalle de Ventas";
}

<div style="max-width:1100px; margin:40px auto; font-family:Arial;">

    <h1>🧾 Detalle de Ventas</h1>

    @if (TempData["Error"] != null)
    {
        <div style="background:#f8d7da;
            color:#842029;
            padding:12px;
            margin-bottom:15px;
            border-radius:5px;">
            @TempData["Error"]
        </div>
    }

    <a href="/DetalleVentasWeb/Crear"
       style="display:inline-block;
        background:#198754;
        color:white;
        padding:10px 18px;
        text-decoration:none;
        border-radius:5px;
        margin:15px 0;">
        ➕ Nuevo detalle
    </a>

    <p>Listado de detalles de ventas registrados en BikeStore.</p>

    <table style="width:100%;
        border-collapse:collapse;
        margin-top:30px;">

        <thead>

            <tr style="background-color:#198754;
                color:white;">

                <th style="padding:12px;">ID</th>
                <th style="padding:12px;">Venta</th>
                <th style="padding:12px;">Bicicleta</th>
                <th style="padding:12px;">Cantidad</th>
                <th style="padding:12px;">Precio Unitario</th>
                <th style="padding:12px;">Subtotal</th>
                <th style="padding:12px;">Acciones</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var detalle in Model)
            {
                <tr style="border-bottom:1px solid #ddd;">

                    <td style="padding:10px;
                        text-align:center;">
                        @detalle.IdDetalle
                    </td>

                    <td style="padding:10px;
                        text-align:center;">
                        @detalle.IdVenta
                    </td>

                    <td style="padding:10px;
                        text-align:center;">
                        @detalle.IdBicicleta
                    </td>

                    <td style="padding:10px;
                        text-align:center;">
                        @detalle.Cantidad
                    </td>

                    <td style="padding:10px;">
                        $@detalle.PrecioUnitario.ToString("0.00")
                    </td>

                    <td style="padding:10px;
                        font-weight:bold;">
                        $@detalle.SubtotalDetalle.ToString("0.00")
                    </td>

                    <td style="padding:10px;
                        text-align:center;">

                        <a href="/DetalleVentasWeb/Editar/@detalle.IdDetalle"
                           style="background:#ffc107;
                            color:black;
                            padding:6px 12px;
                            text-decoration:none;
                            border-radius:5px;">
                            ✏️ Editar
                        </a>

                        <form method="post"
                              action="/DetalleVentasWeb/Eliminar/@detalle.IdDetalle"
                              style="display:inline;"
                              onsubmit="return confirm('¿Está seguro de eliminar este detalle?');">

                            <button type="submit"
                                    style="background:#dc3545;
                                color:white;
                                border:none;
                                padding:6px 12px;
                                border-radius:5px;
                                margin-left:5px;
                                cursor:pointer;">
                                🗑️ Eliminar
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

    <br />

    <a href="/Home/Index">
        ⬅ Volver al inicio
    </a>

</div>
